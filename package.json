{
  "name": "ryby",
  "private": true,
  "version": "2.0.0",
  "description": "Rybářská hra pro děti – české ryby, čtyři lokality, album-encyklopedie.",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5175 --strictPort",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 5175 --strictPort",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "images": "node scripts/build-images.mjs",
    "icons": "node scripts/build-icons.mjs"
  },
  "devDependencies": {
    "sharp": "^0.35.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.1"
  }
}
